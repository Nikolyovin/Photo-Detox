{
  "expo": {
    "name": "Фото-Детокс",
    "slug": "-photo-detox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nikolyovin.photodetox"
    },
    "android": {
      "package": "com.nikolyovin.photodetox",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2D7FF9"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Приложению нужен доступ к вашим фото, чтобы находить скриншоты и удалять мусор.",
          "savePhotosPermission": "Приложению нужен доступ для сохранения изменений.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2D7FF9"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7be5f185-b6cf-42d2-ae44-eeb7b002fa61"
      }
    }
  }
}